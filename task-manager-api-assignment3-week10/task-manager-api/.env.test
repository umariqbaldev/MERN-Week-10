# W1: Separate test database — never touches task_manager (dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DATABASE=task_manager_test

PORT=3001

# Auth
JWT_SECRET=test-jwt-secret-for-integration-tests
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# Low argon2 cost for fast tests (X3 from Week 9)
ARGON2_TIME_COST=1
ARGON2_MEMORY_COST=1024

# Security — very generous limits so tests don't hit throttle
CORS_ORIGIN=http://localhost:3001
THROTTLE_TTL=1000
THROTTLE_LIMIT=10000
